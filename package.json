{
  "name": "@vvi/utils",
  "version": "2.0.7",
  "type": "module",
  "private": true,
  "scripts": {
    "b": "rollup --config rollup.config.js && tsc -p tsconfig.types.json",
    "clean:package": "node scripts/clean-package-json.js",
    "build": "jja rm dist && pnpm run b && pnpm run clean:package",
    "build:local": "jja rm dist && node scripts/build-local.js",
    "clean": "jja tm node_modules package-lock.json pnpm-lock.yaml && pnpm install && pnpm run build",
    "dev": "jja rm .eg && rollup --config rollup.dev.config.js && node .eg/index.mjs",
    "diff": "jja pkg --diff=淘宝",
    "lint": "jja cls && eslint src",
    "beautify": "pnpm run prettier",
    "prettier": "jja cls && prettier . --write",
    "push:version": "gvv",
    "push": "gvv",
    "vjj": "vjj -b",
    "prepublishOnly": "pjj"
  },
  "jja": {
    "pkg": [
      "eslint",
      "typescript"
    ]
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@babel/preset-env": "^8.0.2",
    "@babel/preset-typescript": "^8.0.1",
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-commonjs": "^29.0.2",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/node": "^26.1.1",
    "@vvi/check-version": "^1.1.2",
    "@vvi/copy-text": "^1.1.2",
    "@vvi/node": "^5.0.0",
    "@vvi/pen": "^3.0.2",
    "@vvi/rollup-external": "^1.2.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "^63.0.13",
    "eslint-plugin-jsonc": "^3.3.0",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.7.0",
    "gvv": "^1.0.2",
    "jja": "^2.5.4",
    "pjj": "^1.0.7",
    "prettier": "^3.9.5",
    "rollup": "^4.62.2",
    "rollup-plugin-cleanup": "^3.2.1",
    "rollup-plugin-copy": "^3.5.0",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.64.0",
    "vjj": "^1.0.14"
  },
  "packageManager": "pnpm@11.13.0+sha512.88d94724d8f2e6c186744a5584c6e59ecac869ec7ba15e9cb4cd628e8dc7066820b2481d8ee3b51ea8da323a7378068aa58c556a3720d32b7c20a051d088363a",
  "dependencies": {
    "@vvi/is": "^2.0.6"
  }
}
